generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AddonCategory {
  MILK
  SYRUP
  EXTRA
  OTHER
}

enum DrinkTemperature {
  HOT
  COLD
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Drink {
  id             String      @id @default(cuid())
  name           String
  description    String
  basePriceCents Int
  seasonal       Boolean     @default(false)
  customizationsConfigured Boolean @default(false)
  supportsHot     Boolean     @default(true)
  supportsCold    Boolean     @default(true)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  customizations DrinkAddon[]
}

model Addon {
  id         String           @id @default(cuid())
  name       String
  priceCents Int
  category   AddonCategory     @default(OTHER)
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  items      OrderItemAddon[]
  drinks     DrinkAddon[]
}

model DrinkAddon {
  drinkId        String
  addonId        String
  defaultSelected Boolean @default(false)
  drink          Drink   @relation(fields: [drinkId], references: [id], onDelete: Cascade)
  addon          Addon   @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([drinkId, addonId])
}

model Order {
  id           String      @id @default(cuid())
  customerName String
  totalCents   Int
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id             String           @id @default(cuid())
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id])
  drinkId        String
  drink          Drink            @relation(fields: [drinkId], references: [id])
  drinkName      String
  unitPriceCents Int
  quantity       Int
  temperature    DrinkTemperature @default(HOT)
  addons         OrderItemAddon[]
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  addonId     String
  addon       Addon     @relation(fields: [addonId], references: [id])
  addonName   String
  priceCents  Int
}
